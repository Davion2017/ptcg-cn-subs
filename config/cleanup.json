{
  "_comment": "翻译后清洗规则。replace: 直接字符串替换（长的写前面）；regex: 正则替换。酸奶=「你」的 token 崩坏。",
  "replace": {
    "茶火箭队": "火箭队",
    "精神强念": "超能",
    "超能力系": "超能系",
    "恶系能量": "恶能量",
    "斗系": "格斗系",
    "草系能量": "草能量",
    "火系能量": "火能量",
    "水系能量": "水能量",
    "电系能量": "电能量",
    "超系": "超能系",
    "茶队": "火箭队",
    "牌库": "卡组",
    "酸奶回合一次": "每回合一次",
    "酸奶对手": "对手",
    "酸奶手牌": "手牌",
    "酸奶": "你"
  },
  "regex": [
    [
      "^[\\s,，。、]+",
      ""
    ],
    [
      "[\\s,，、]+$",
      ""
    ],
    [
      "([\\u4e00-\\u9fff])[，,]{2,}",
      "\\1，"
    ],
    [
      "\\s{2,}",
      " "
    ]
  ],
  "forbid_english_only_lines": false
}